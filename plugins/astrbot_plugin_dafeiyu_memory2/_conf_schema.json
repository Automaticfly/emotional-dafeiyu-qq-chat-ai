{
  "enabled": {
    "description": "启用记忆 2.0",
    "hint": "关闭后不记录聊天、不注入索引、不执行凌晨结算，已有数据仍保留。",
    "type": "bool",
    "default": true
  },
  "injection_enabled": {
    "description": "注入记忆索引",
    "hint": "在每轮对话的 system prompt 末尾追加一段很短的数量索引，不塞正文。",
    "type": "bool",
    "default": true
  },
  "main_umo": {
    "description": "主要结算会话 UMO",
    "hint": "留空则自动结算最近 24 小时有消息的会话；建议填 napcat:FriendMessage:你的大号QQ。",
    "type": "string",
    "default": ""
  },
  "settle_enabled": {
    "description": "启用凌晨结算",
    "hint": "每天在结算时间窗内读取最近 24 小时聊天，调用一次模型做记忆决策。",
    "type": "bool",
    "default": true
  },
  "settle_start_hour": {
    "description": "结算开始小时",
    "hint": "24 小时制，默认 4 点。",
    "type": "int",
    "default": 4
  },
  "settle_end_hour": {
    "description": "结算结束小时",
    "hint": "24 小时制，默认 8 点；到点后不再重试。",
    "type": "int",
    "default": 8
  },
  "settle_interval_seconds": {
    "description": "结算重试间隔（秒）",
    "hint": "失败后每隔这么久重试一次，默认 600 秒。",
    "type": "int",
    "default": 600
  },
  "max_transcript_chars": {
    "description": "结算读取的最大聊天字数",
    "hint": "超出后只取最近的部分，默认 12000。",
    "type": "int",
    "default": 12000
  },
  "max_umo_per_settle": {
    "description": "单轮最多结算会话数",
    "hint": "避免一次结算太多会话，默认 5。",
    "type": "int",
    "default": 5
  },
  "max_items_per_settle": {
    "description": "单类记忆最多送入结算的条数",
    "hint": "日记、日程、画像各自的上限，默认 30。",
    "type": "int",
    "default": 30
  },
  "normal_init_days": {
    "description": "普通日记初始寿命（天）",
    "type": "int",
    "default": 7
  },
  "normal_extend_days": {
    "description": "普通日记每次延长（天）",
    "type": "int",
    "default": 3
  },
  "normal_warn_days": {
    "description": "普通日记提前提醒（天）",
    "type": "int",
    "default": 1
  },
  "important_init_days": {
    "description": "重要日记初始寿命（天）",
    "type": "int",
    "default": 21
  },
  "important_extend_days": {
    "description": "重要日记每次延长（天）",
    "type": "int",
    "default": 7
  },
  "important_warn_days": {
    "description": "重要日记提前提醒（天）",
    "type": "int",
    "default": 3
  },
  "eternal_init_days": {
    "description": "刻骨铭心日记初始寿命（天）",
    "type": "int",
    "default": 90
  },
  "eternal_extend_days": {
    "description": "刻骨铭心日记每次延长（天）",
    "type": "int",
    "default": 30
  },
  "eternal_warn_days": {
    "description": "刻骨铭心日记提前提醒（天）",
    "type": "int",
    "default": 7
  },
  "normal_upgrade_after_days": {
    "description": "普通日记提示升档的寿命（天）",
    "hint": "总寿命超过这个天数时提示可以考虑升档，默认 13。",
    "type": "int",
    "default": 13
  },
  "important_upgrade_after_days": {
    "description": "重要日记提示升档的寿命（天）",
    "hint": "总寿命超过这个天数时提示可以升到刻骨铭心，默认 60。",
    "type": "int",
    "default": 60
  },
  "important_downgrade_remaining_days": {
    "description": "重要日记提示降档的剩余天数",
    "type": "int",
    "default": 10
  },
  "eternal_downgrade_remaining_days": {
    "description": "刻骨铭心提示降档的剩余天数",
    "type": "int",
    "default": 30
  },
  "diary_title_max_chars": {
    "description": "日记标题最大字数",
    "type": "int",
    "default": 40
  },
  "diary_content_max_chars": {
    "description": "日记正文最大字数",
    "type": "int",
    "default": 2000
  },
  "list_default_limit": {
    "description": "列表默认条数",
    "type": "int",
    "default": 10
  },
  "list_max_limit": {
    "description": "列表最大条数",
    "type": "int",
    "default": 50
  },
  "portrait_max_chars": {
    "description": "画像单条最大字数",
    "hint": "规格要求最多 120 字。",
    "type": "int",
    "default": 120
  },
  "portrait_initial_strength": {
    "description": "新画像初始强度",
    "type": "int",
    "default": 60
  },
  "portrait_strength_step": {
    "description": "画像默认加强幅度",
    "type": "int",
    "default": 5
  },
  "portrait_high_strength": {
    "description": "提示写进日记的画像强度阈值",
    "type": "int",
    "default": 70
  },
  "portrait_decay_after_days": {
    "description": "画像多久没提及后开始降强度（天）",
    "type": "int",
    "default": 30
  },
  "portrait_decay_interval_days": {
    "description": "画像降强度间隔（天）",
    "type": "int",
    "default": 7
  },
  "portrait_decay_amount": {
    "description": "画像每次降低的强度",
    "type": "int",
    "default": 2
  },
  "schedule_content_max_chars": {
    "description": "日程单条最大字数",
    "type": "int",
    "default": 300
  },
  "recycle_max_list": {
    "description": "回收站最多显示条数",
    "type": "int",
    "default": 30
  }
}
